# DataRobot Custom Application Configuration
# Copy this file to .env and fill in your values

# ===========================================
# DEPLOYMENT CONFIGURATION (Required)
# ===========================================

# DataRobot Environment ID (required for deployment)
# Run 'drapps ls envs' to find available environment IDs
# Common choice: Python 3.12 Applications Base
DATAROBOT_ENV_ID=

# Application name in DataRobot (change this for your app)
DATAROBOT_APP_NAME=My Custom App

# Application ID (set after first deploy, used for updates)
# Find with 'drapps ls apps' after deploying
DATAROBOT_APP_ID=

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Application title displayed in the UI
APP_TITLE=My App

# Enable debug mode (true/false)
DEBUG=false

# Server port (for local development only)
PORT=8000

# ===========================================
# ADD YOUR CUSTOM PARAMETERS BELOW
# ===========================================
# Remember to also add them to deploy-config/metadata.yaml
# for DataRobot runtime configuration
