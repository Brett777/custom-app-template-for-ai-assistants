# DataRobot Custom Application Configuration
# Copy this file to .env and fill in your values

# ===========================================
# DEPLOYMENT CONFIGURATION (Required)
# ===========================================

# DataRobot Environment ID (required for deployment)
# Run 'drapps ls envs' to find available environment IDs
# Common choice: Python 3.12 Applications Base
DATAROBOT_ENV_ID=

# Application name in DataRobot (change this for your app)
DATAROBOT_APP_NAME=My Custom App

# Application ID (set after first deploy, used for updates)
# Find with 'drapps ls apps' after deploying
DATAROBOT_APP_ID=

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Application title displayed in the UI
APP_TITLE=My App

# Enable debug mode (true/false)
DEBUG=false

# Server port (for local development only)
PORT=8000

# ===========================================
# AGENT DEPLOYMENT SETTINGS
# ===========================================
# Configure these to connect to a DataRobot Agent Deployment
# See agent-templates/ for creating and deploying agents

# Agent Deployment ID (from 'task deploy' output in agent-templates)
AGENT_DEPLOYMENT_ID=

# DataRobot API Token (for agent authentication)
# Create at: https://app.datarobot.com/account/developer-tools
DATAROBOT_API_TOKEN=

# DataRobot API Endpoint (default for cloud)
DATAROBOT_ENDPOINT=https://app.datarobot.com

# ===========================================
# LLM GATEWAY SETTINGS
# ===========================================
# DataRobot LLM Gateway provides unified access to multiple LLM providers
# Uses the same DATAROBOT_API_TOKEN and DATAROBOT_ENDPOINT as above

# Default model for LLM Gateway (optional)
# Format: datarobot/<provider>/<model>
# Examples: datarobot/azure/gpt-4o-mini, datarobot/azure/gpt-4o
LLM_DEFAULT_MODEL=datarobot/azure/gpt-4o-mini

# ===========================================
# MCP SERVER SETTINGS (Optional)
# ===========================================
# Configure if using MCP tools with LLM Gateway or agents

# MCP Server URL (from 'task deploy' in mcp-server-template)
DR_MCP_SERVER_URL=

# ===========================================
# ADD YOUR CUSTOM PARAMETERS BELOW
# ===========================================
# Remember to also add them to deploy-config/metadata.yaml
# for DataRobot runtime configuration
